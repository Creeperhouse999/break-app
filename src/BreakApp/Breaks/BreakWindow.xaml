<Window x:Class="BreakApp.Breaks.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <Grid x:Name="Root" Opacity="0">
        <!-- Fullscreen backdrop: theme background + soft accent glow -->
        <Grid x:Name="Backdrop">
            <Border Background="{DynamicResource BreakBackgroundBrush}" />
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.6" RadiusY="0.7">
                        <GradientStop Color="{DynamicResource Accent1Color}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.Opacity>0.22</Border.Opacity>
            </Border>
            <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.35" />
        </Grid>

        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" CornerRadius="22">
            <StackPanel x:Name="Content" HorizontalAlignment="Center" MaxWidth="720">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="12" Height="12" CornerRadius="4" Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RuleName" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource BreakTextBrush}" Opacity="0.75" />
                </StackPanel>

                <!-- countdown: ring -->
                <Grid x:Name="RingHost" Width="300" Height="300" HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="12" Margin="6" />
                    <Path x:Name="RingArc" Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="12"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock x:Name="RingText" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BreakTextBrush}" />
                </Grid>

                <!-- countdown: big number -->
                <TextBlock x:Name="BigText" FontFamily="{StaticResource DisplayFont}" FontSize="88" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource BreakTextBrush}" />

                <!-- countdown: bar -->
                <StackPanel x:Name="BarHost" Width="420" HorizontalAlignment="Center">
                    <TextBlock x:Name="BarText" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource BreakTextBrush}" Margin="0,0,0,14" />
                    <Grid Height="10">
                        <Border CornerRadius="5" Background="{DynamicResource TrackBrush}" />
                        <Border x:Name="BarFill" CornerRadius="5" Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="MessageText" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,28,0,0" Foreground="{DynamicResource BreakTextBrush}" />
                <TextBlock x:Name="MergedText" FontSize="13" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource Text3Brush}" />

                <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Button x:Name="PostponeButton" Height="36" Padding="18,0" Margin="0,0,10,0" FontSize="13.5" />
                    <Button x:Name="SkipButton" Height="36" Padding="18,0" FontSize="13.5" Content="Skip break" />
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="12.5" TextAlignment="Center" Margin="0,18,0,0" Foreground="{DynamicResource Text3Brush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
