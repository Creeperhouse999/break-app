<Window x:Class="BreakApp.Notifications.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break App notification"
        Width="428" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <!-- transparent margin around the card leaves room for the soft shadow and the pulse -->
    <Grid x:Name="Root" Margin="24,18,24,24" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="Slide" X="46" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Card" CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="0.24" BlurRadius="26" ShadowDepth="8" Direction="270" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="16" BorderBrush="{DynamicResource RingBrush}" BorderThickness="1" IsHitTestVisible="False" />

        <!-- flash overlay: tinted fill + bright outline, opacity animated -->
        <Border x:Name="Glow" CornerRadius="16" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />

        <!-- accent stripe -->
        <Border x:Name="Stripe" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="0,3,3,0" />

        <Grid Margin="14,14,12,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconChip" Width="34" Height="34" CornerRadius="11" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="IconScale" ScaleX="0.5" ScaleY="0.5" />
                </Border.RenderTransform>
                <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,1,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Break App" FontSize="11" Margin="5,0,0,0" Foreground="{DynamicResource Text3Brush}" />
                </StackPanel>
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,24,0" />
                <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="72" Margin="0,1,0,0" />
                <TextBlock x:Name="CountdownText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24" FontSize="10"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" ToolTip="Close" />

        <!-- life bar -->
        <Grid VerticalAlignment="Bottom" Height="3" Margin="16,0,16,6" x:Name="LifeBar">
            <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
            <Border x:Name="LifeFill" CornerRadius="1.5" RenderTransformOrigin="0,0.5" Opacity="0.85">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LifeScale" ScaleX="1" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</Window>
